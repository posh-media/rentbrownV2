# ─────────────────────────────────────────────────────────────
# RentBrown V2 — environment template. Copy to .env.local / .env
# NEVER commit real secrets. Values here are placeholders only.
# ─────────────────────────────────────────────────────────────

# Environment: development | staging | production
NODE_ENV=development
APP_ENV=development

# ── API (NestJS on Cloud Run) ────────────────────────────────
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001

# ── Supabase (Postgres = financial source of truth) ──────────
# Project URL — e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key — safe for client-side use (auth only)
SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY, bypasses RLS. Never in clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string (session pooler or direct)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Legacy HS256 JWT secret fallback (prefer JWKS verification)
SUPABASE_JWT_SECRET=

# ── Frontend apps ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Worker ───────────────────────────────────────────────────
# Uses the same DATABASE_URL — pg-boss lives in its own `pgboss` schema.
# Shared secret Cloud Scheduler sends as x-scheduler-key (min 32 chars)
SCHEDULER_SECRET=

# ── Providers (Phase 2+; keys stay server-side only) ─────────
PAYSTACK_SECRET_KEY=
KORAPAY_SECRET_KEY=
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=
# sandbox | production
SMILE_IDENTITY_ENV=sandbox
SMILE_IDENTITY_CALLBACK_URL=
# Supabase Storage PRIVATE bucket for KYC docs (created manually — see DEPLOYMENT.md)
KYC_DOCUMENTS_BUCKET=kyc-documents
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
EMAIL_PROVIDER_API_KEY=

# ── Security ─────────────────────────────────────────────────
# Comma-separated allowed CORS origins for API
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
# Enforce Supabase MFA (aal2) on admin endpoints. "false" is a dev-only
# override — ignored when APP_ENV=production (always enforced there).
# ADMIN_MFA_ENFORCE=true
# Comma-separated emails granted super_admin on first provisioning
# (alternative to `pnpm --filter @rentbrown/api grant-role`).
# BOOTSTRAP_SUPER_ADMIN_EMAILS=

{
  "expo": {
    "name": "RentBrown",
    "slug": "rentbrown",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rentbrown",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store", "expo-font"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentbrown.app"
    },
    "android": {
      "package": "com.rentbrown.app"
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID — run `npx eas init` (see docs/DEPLOYMENT.md)"
      }
    }
  }
}

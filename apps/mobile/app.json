{
  "expo": {
    "name": "RentBrown",
    "slug": "rentbrown",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rentbrown",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentbrown.app"
    },
    "android": {
      "package": "com.rentbrown.app"
    },
    "extra": {
      "eas": {
        "projectId": "a34d7331-8a37-4031-b2ac-4a57c57497d5"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "devposh"
  }
}
